# Paste the Neon connection string here. Never commit this file after filling it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENVIRONMENT=development
# Explicit origins only (no wildcards in production). Deployed frontend example:
# CORS_ORIGINS=["https://postharvest-kappa.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]
JWT_EXPIRY_MINUTES=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Device pairing codes (defaults shown)
PAIRING_TTL_SECONDS=900
PAIRING_RATE_LIMIT=10
PAIRING_RATE_WINDOW_SECONDS=60
# Ask-your-data chat (defaults shown)
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
CHAT_EVIDENCE_CHARS=12000
